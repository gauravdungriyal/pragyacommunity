# Pragya Connect Frontend Environment Configuration Example

# --- Live Pragya Yog API (https://pragya-yog.com/docs/) -------------------
# Sign-in, profile, events, teachers, classes and the daily quote are served
# from here. CORS is open, so the browser calls it directly.
VITE_PRAGYA_API_URL=https://pragya-yog.com/api.php
VITE_PRAGYA_UPLOADS_URL=https://pragya-yog.com/uploads/

# Booking and payment actions create real records on the live system.
# They are blocked unless this is explicitly set to true.
VITE_PRAGYA_ALLOW_WRITES=false

# --- Local backend --------------------------------------------------------
# Serves the features the live API does not cover: community feed, courses,
# course group chat and the admin portal.
VITE_API_URL=/api
VITE_MEDIA_BASE_URL=https://pragya-yog.com/uploads/
